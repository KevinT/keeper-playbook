{
	"//": "Type-check the generated extensions against a pi source checkout. PI_CHECKOUT defaults to ~/.hermes/cache/scratch/pi; see node/README.md.",
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"paths": {
			"@earendil-works/chord": ["./pi/packages/chord/src/index.ts"],
			"@earendil-works/chord/context": ["./pi/packages/chord/src/context/index.ts"],
			"@earendil-works/chord/delta": ["./pi/packages/chord/src/delta/index.ts"],
			"@earendil-works/pi-telemetry": ["./pi/packages/telemetry/src/index.ts"],
			"@earendil-works/pi-ai": ["./pi/packages/ai/src/index.ts"],
			"@earendil-works/pi-ai/models": ["./pi/packages/ai/src/models.ts"],
			"@earendil-works/pi-ai/providers/*": ["./pi/packages/ai/src/providers/*.ts"],
			"@earendil-works/pi-ai/*": ["./pi/packages/ai/src/*.ts"],
			"@earendil-works/pi-durable": ["./pi/packages/durable/src/index.ts"],
			"@earendil-works/pi-durable/*": ["./pi/packages/durable/src/*.ts", "./pi/packages/durable/src/*/index.ts"]
		}
	},
	"include": ["generated/**/*.ts"]
}
